# ============================================
# LLM Provider Configuration
# ============================================

# LLM provider to use (currently only 'mistral' is supported)
LLM_PROVIDER=mistral

# Mistral API Key
# Get your free tier API key at: https://console.mistral.ai/
# 1. Sign up or log in to Mistral AI Console
# 2. Navigate to "API Keys" section
# 3. Click "Create new key" and copy it here
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral model to use for summarization
# Options: mistral-large-latest, mistral-medium-latest, mistral-small-latest
# Recommendation: Use mistral-large-latest for best quality summaries
MISTRAL_MODEL=mistral-large-latest

# ============================================
# Telegram Bot Configuration
# ============================================

# Telegram Bot Token
# Get your token from @BotFather on Telegram:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow instructions
# 3. Choose a name and username for your bot
# 4. Copy the HTTP API token provided and paste here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# Database Configuration
# ============================================

# Database path (SQLite for development/MVP)
# The database will be auto-created at this location
# For production, consider migrating to PostgreSQL
DB_PATH=data/sota_radar.db

# ============================================
# Pipeline Configuration
# ============================================

# How often to run the background summarization pipeline (in minutes)
# Recommendation: 5-10 minutes for development, 60 for production
PIPELINE_INTERVAL_MINUTES=5

# Maximum number of papers to fetch per arXiv category per run
MAX_RESULTS_PER_CATEGORY=100

# Number of papers to show in /digest command
PAPERS_PER_DIGEST=10
